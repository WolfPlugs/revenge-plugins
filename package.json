{
	"name": "@wolfplugs/revenge-plugins",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "revenge-plugin build",
		"build:dev": "revenge-plugin build --dev",
		"generate-index": "revenge-plugin generate-index",
		"plan-releases": "revenge-plugin plan-releases",
		"serve": "revenge-plugin serve",
		"lint": "biome check",
		"lint:types": "tsc --noEmit",
		"package": "bun run build && bun scripts/package.mjs"
	},
	"dependencies": {
		"@revenge-mod/plugin-cli": "git+https://github.com/revenge-mod/revenge-plugin-cli.git",
		"@revenge-mod/types": "git+https://github.com/revenge-mod/revenge-types.git",
		"fflate": "^0.8.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"react-native": "0.81.6",
		"typescript": "^7.0.2",
		"@react-native-community/netinfo": "^12.0.1"
	},
	"overrides": {
		"@react-native/community-cli-plugin": "npm:dry-uninstall",
		"@react-native/codegen": "npm:dry-uninstall",
		"babel-jest": "npm:dry-uninstall",
		"babel-plugin-syntax-hermes-parser": "npm:dry-uninstall",
		"hermes-compiler": "npm:dry-uninstall",
		"jsc-android": "npm:dry-uninstall",
		"react-devtools-core": "npm:dry-uninstall",
		"recyclerlistview": "npm:dry-uninstall",
		"react-native-gesture-handler": "npm:dry-uninstall",
		"react-native-screens": "npm:dry-uninstall"
	},
	"trustedDependencies": [
		"@revenge-mod/plugin-cli",
		"@swc/core"
	]
}
